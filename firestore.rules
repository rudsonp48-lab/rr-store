rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Catálogo de produtos público para leitura ultra-rápida
    match /rr_store_products/{productId} {
      allow read: if true;
      allow write: if false;
    }

    // Criação de pedidos pelo checkout híbrido da RR Store
    match /rr_store_orders/{orderId} {
      allow create: if request.resource.data.orderCode is string
                    && request.resource.data.finalTotal is number;
      allow read, update, delete: if false;
    }
  }
}
